# Leave unset during local development to skip the access-code screen.
DEMO_ACCESS_CODE=

# Use "fake" for deterministic local development and automated tests.
STORY_MODEL_MODE=fake

# Required when STORY_MODEL_MODE=live.
STORY_MODEL_BASE_URL=https://api.example.com/v1
STORY_MODEL_API_KEY=
STORY_MODEL_NAME=

# Optional request timeout in milliseconds.
STORY_MODEL_TIMEOUT_MS=90000
